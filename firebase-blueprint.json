{
  "entities": {
    "World": {
      "title": "World",
      "description": "A saved story world entry representing a book or show loved by the user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the book or show",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "description": "Media type (book, show, setting, or blend)",
          "enum": ["book", "show", "setting", "blend"]
        },
        "note": {
          "type": "string",
          "description": "Optional note on what the user loved about it or setting description",
          "maxLength": 2000
        },
        "genre": {
          "type": "string",
          "description": "Optional genre classification",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Status of the world record",
          "enum": ["saved", "draft", "exploring", "ready"]
        },
        "tone": {
          "type": "string",
          "description": "Atmospheric tone generated by Gemini",
          "maxLength": 300
        },
        "themes": {
          "type": "array",
          "description": "3 to 6 selected canonical world themes"
        },
        "blurb": {
          "type": "string",
          "description": "World blurb up to 60 words",
          "maxLength": 1500
        },
        "places": {
          "type": "array",
          "description": "Interconnected places with id, name, description, connects_to, and lock state"
        },
        "characters": {
          "type": "array",
          "description": "Archetypal characters with name, role, description, and linked place"
        },
        "storyHooks": {
          "type": "array",
          "description": "5 campaign story hooks for tabletop game masters and writers"
        },
        "sources": {
          "type": "array",
          "description": "Source titles or genres when blending"
        },
        "generationType": {
          "type": "string",
          "description": "Type of world generation (setting, blend, or single)"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the world is shared publicly as read-only"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "title", "type", "createdAt", "updatedAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Seeded catalog entry representing a canonical book or show with theme vectors",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the work"
        },
        "type": {
          "type": "string",
          "description": "Medium type",
          "enum": ["book", "show"]
        },
        "creator": {
          "type": "string",
          "description": "Author, director, or showrunner"
        },
        "year": {
          "type": "string",
          "description": "Year of release or publication"
        },
        "mood": {
          "type": "string",
          "description": "Dominant atmospheric mood"
        },
        "themes": {
          "type": "array",
          "description": "Canonical themes present in the story"
        },
        "themeVector": {
          "type": "array",
          "description": "20-dimensional mathematical theme vector"
        },
        "blurb": {
          "type": "string",
          "description": "Evocative summary of the work"
        }
      },
      "required": ["title", "type", "creator", "mood", "themes", "themeVector"]
    },
    "Usage": {
      "title": "Usage",
      "description": "User usage tracking document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "worldCount": {
          "type": "number",
          "description": "Total worlds created"
        },
        "generationCount": {
          "type": "number",
          "description": "Number of generations run"
        },
        "lastGenerationDate": {
          "type": "string",
          "description": "Date of latest generation (YYYY-MM-DD)"
        },
        "dailyGenerationsCount": {
          "type": "number",
          "description": "Count of generations performed today (limit 10)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "worldCount", "generationCount", "updatedAt"]
    },
    "GenerationCache": {
      "title": "GenerationCache",
      "description": "Cached generations to preserve free tier quota",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator"
        },
        "cacheKey": {
          "type": "string",
          "description": "Deterministic cache key for inputs (normalized title)",
          "maxLength": 256
        },
        "content": {
          "type": "string",
          "description": "Cached response content JSON",
          "maxLength": 15000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Cache creation timestamp"
        }
      },
      "required": ["userId", "cacheKey", "content", "createdAt"]
    }
  },
  "firestore": {
    "/worlds/{worldId}": {
      "schema": {
        "$ref": "#/entities/World"
      },
      "description": "Collection of story worlds and titles created by users"
    },
    "/catalog/{itemId}": {
      "schema": {
        "$ref": "#/entities/CatalogItem"
      },
      "description": "Curated catalog of 60 canonical books and shows for semantic theme recommendations"
    },
    "/usage/{userId}": {
      "schema": {
        "$ref": "#/entities/Usage"
      },
      "description": "Per-user usage counters and activity tracking"
    },
    "/generation_cache/{cacheId}": {
      "schema": {
        "$ref": "#/entities/GenerationCache"
      },
      "description": "Cached generation outputs to optimize quota and speed"
    }
  }
}
